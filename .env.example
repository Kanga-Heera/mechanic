# Stage 3 Phase 3 LLM repair generator config. Copy this file to `.env`
# (gitignored - never commit the real one) and fill in your own key, OR
# just export these as real environment variables in your shell - either
# works, see mechanic/llm_client.py.
#
# Free-tier key: https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# Optional overrides - uncomment to point at a different OpenAI-compatible
# endpoint (a local Ollama instance, a paid provider, ...) instead of Groq.
# MECHANIC_LLM_BASE_URL=http://localhost:11434/v1
# MECHANIC_LLM_MODEL=llama3.3:70b
